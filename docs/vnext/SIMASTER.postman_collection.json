            "description": "Observed in the release binary. Use only in an authorized development environment."
          }
        },
        {
          "name": "Exchange authorization code - confirmed implementation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/x-www-form-urlencoded"}
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "grant_type", "value": "authorization_code"},
                {"key": "code", "value": "{{authorization_code}}"},
                {"key": "redirect_uri", "value": "{{oauth_redirect_uri}}"},
                {"key": "client_id", "value": "{{oauth_client_id}}"},
                {"key": "client_secret", "value": "{{oauth_client_secret}}", "description": "The cross-checked implementation sends a client_secret; use a rotated authorized value and never commit it."}
              ]
            },
            "url": {
              "raw": "{{oauth_base}}/oauth/token",
              "host": ["{{oauth_base}}"],
              "path": ["oauth", "token"]
            },
            "description": "POST form fields and client_secret are confirmed by the cross-checked implementation. The public repository contains a hardcoded secret; it is intentionally not copied here. The test script stores access_token and refresh_token from the JSON response."
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["let data = null;", "try { data = pm.response.json(); } catch (e) {}", "if (data && data.access_token) pm.collectionVariables.set('access_token', data.access_token);", "if (data && data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);", "if (data && data.expires_in !== undefined) pm.collectionVariables.set('access_token_expires_in', String(data.expires_in));", "pm.test('Bearer access token captured', function () { pm.expect(data && data.access_token, 'access_token in token response').to.be.ok; });"]}}],
          "response": [
            {
              "name": "Illustrative token response",
