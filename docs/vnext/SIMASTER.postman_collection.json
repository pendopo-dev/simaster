          },
          "description": "Confirmed flow step. The test script captures the OAuth session cookie and, if the server skips consent, captures an authorization code directly.",
          "protocolProfileBehavior": {"disableFollowRedirect": true},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const setCookie = pm.response.headers.get('Set-Cookie') || '';", "const session = pm.cookies.get('ugm_oauth_session') || pm.cookies.get('session') || ((setCookie.match(/(?:^|[;,])\\s*ugm_oauth_session=([^;,\\s]+)/i) || [])[1]);", "if (session) pm.collectionVariables.set('oauth_session_cookie', session);", "pm.collectionVariables.set('oauth_session_cookie_name', session ? (pm.cookies.get('ugm_oauth_session') ? 'ugm_oauth_session' : 'session') : '');", "const location = pm.response.headers.get('Location') || '';", "const code = location.match(/[?&]code=([^&#]+)/i);", "if (code) pm.collectionVariables.set('authorization_code', decodeURIComponent(code[1]));"]}}]
        },
        {
          "name": "Authorize with ticket - consent page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{oauth_base}}/oauth/authorize?response_type=code&client_id={{oauth_client_id}}&redirect_uri={{oauth_redirect_uri_encoded}}&scope={{oauth_scope}}&ticket={{oauth_ticket}}"
          },
          "description": "Confirmed flow step. The test script extracts csrf_token when consent HTML is returned. Some sessions may return 302 directly with a code.",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const html = pm.response.text();", "const quote = String.fromCharCode(34);", "const csrfStart = html.indexOf('name=' + quote + 'csrf_token' + quote);", "const valueStart = html.indexOf('value=' + quote, csrfStart);", "const valueEnd = valueStart >= 0 ? html.indexOf(quote, valueStart + 7) : -1;", "const csrfValue = valueStart >= 0 && valueEnd >= 0 ? html.slice(valueStart + 7, valueEnd) : null;", "if (csrfValue) pm.collectionVariables.set('csrf_token', csrfValue);", "const location = pm.response.headers.get('Location') || '';", "const code = location.match(/[?&]code=([^&#]+)/i);", "if (code) pm.collectionVariables.set('authorization_code', decodeURIComponent(code[1]));", "pm.test('Consent token or direct code found', function () { pm.expect(csrfValue || code, 'csrf_token or authorization code').to.not.equal(null); });"]}}]
        },
