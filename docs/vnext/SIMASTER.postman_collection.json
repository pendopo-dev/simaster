              ]
            },
            "url": "{{sso_base}}/cas/login?service={{oauth_service_url_encoded}}"
          },
          "description": "Use the exact form action returned by the authorize HTML. The current response uses /cas/login?service=... without ;jsessionid and relies on the preserved JSESSIONID cookie. Submit the fresh hidden lt value; it is one-time/session-bound. The test script captures the CAS ticket from the 302 Location header.",
          "protocolProfileBehavior": {"disableFollowRedirect": true},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const location = pm.response.headers.get('Location') || '';", "const ticket = location.match(/[?&]ticket=([^&#]+)/i);", "if (ticket) pm.collectionVariables.set('oauth_ticket', decodeURIComponent(ticket[1]));", "pm.test('CAS ticket captured', function () { pm.expect(ticket, 'ticket in Location header').to.not.equal(null); });"]}}]
        },
        {
