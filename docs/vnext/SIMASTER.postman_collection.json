      "name": "01 - OAuth",
      "item": [
        {
          "name": "Authorize - production",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{oauth_base}}/oauth/authorize?response_type=code&client_id={{oauth_client_id}}&redirect_uri={{oauth_redirect_uri_encoded}}&scope={{oauth_scope}}",
              "host": ["{{oauth_base}}"],
              "path": ["oauth", "authorize"],
              "query": [
                {"key": "response_type", "value": "code"},
                {"key": "client_id", "value": "{{oauth_client_id}}"},
                {"key": "redirect_uri", "value": "{{oauth_redirect_uri_encoded}}"},
                {"key": "scope", "value": "{{oauth_scope}}"}
              ]
            },
            "description": "Observed OAuth URL. The returned SSO HTML is parsed automatically for lt, JSESSIONID, and the encoded service value. Do not run against production without authorization."
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const html = pm.response.text();", "const quote = String.fromCharCode(34);", "const ltStart = html.indexOf('name=' + quote + 'lt' + quote);", "const valueStart = html.indexOf('value=' + quote, ltStart);", "const valueEnd = valueStart >= 0 ? html.indexOf(quote, valueStart + 7) : -1;", "const ltValue = valueStart >= 0 && valueEnd >= 0 ? html.slice(valueStart + 7, valueEnd) : null;", "if (ltValue) pm.collectionVariables.set('lt_token', ltValue);", "const jsession = pm.cookies.get('JSESSIONID');", "if (jsession) pm.collectionVariables.set('jsessionid', jsession);", "const formStart = html.indexOf('<form');", "const actionStart = html.indexOf('action=' + quote, formStart);", "const actionEnd = actionStart >= 0 ? html.indexOf(quote, actionStart + 8) : -1;", "const action = actionStart >= 0 && actionEnd >= 0 ? html.slice(actionStart + 8, actionEnd) : '';", "const serviceStart = action.indexOf('service=');", "if (serviceStart >= 0) pm.collectionVariables.set('oauth_service_url_encoded', action.slice(serviceStart + 8));", "pm.test('SSO login form and lt token found', function () { pm.expect(ltValue, 'lt hidden field').to.not.equal(null); });"]}}]
        },
        {
          "name": "Authorize - development/Postman callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{oauth_dev_base}}/oauth/authorize?response_type=code&client_id={{oauth_dev_client_id}}&redirect_uri={{oauth_dev_redirect_uri}}&scope={{oauth_scope}}",
              "host": ["{{oauth_dev_base}}"],
              "path": ["oauth", "authorize"],
              "query": [
                {"key": "response_type", "value": "code"},
                {"key": "client_id", "value": "{{oauth_dev_client_id}}"},
                {"key": "redirect_uri", "value": "{{oauth_dev_redirect_uri}}"},
                {"key": "scope", "value": "{{oauth_scope}}"}
              ]
